# =============================================================================
# SecureNeuroGrade — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets.
# =============================================================================

# Flask application secret key (change this to a strong random value)
SECRET_KEY=change-me-to-a-strong-random-secret-key

# Database URL (SQLite for local development)
DATABASE_URL=sqlite:///secureneurograde.db

# AES-256 encryption key for medical image protection (32 bytes, hex-encoded)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-generated-securely

# Flask environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# Upload configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_FOLDER=uploads

# Logging level
LOG_LEVEL=INFO
